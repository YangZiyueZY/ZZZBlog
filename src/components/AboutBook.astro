---
import { aboutInfo } from '../data/about';
---

<div class="book" id="about-book">
    <div class="book_nav">
        <ul class="absolute flex flex-row items-end justify-between px-4 bottom-1/2 gap-4 text-[#BBBBBB] font-bold italic">
            {
                aboutInfo.map((group, gi) => (
                    <li
                        data-role="group-tab"
                        data-group={gi}
                        class:list={[
                            'px-[2.5rem] py-[.6rem] bg-[repeating-linear-gradient(110deg,transparent,transparent_4px,rgba(0,0,0,.02)_4px,rgba(0,0,0,.02)_15px),linear-gradient(150deg,#707070,#464646)] rounded-[.7rem_.7rem_0_0] text-shadow-black cursor-pointer hover:text-[#808080]',
                            { active: gi === 0 },
                        ]}
                    >
                        {group.title}
                    </li>
                ))
            }
        </ul>
    </div>
    <div class="book_projection">
        <!-- clip-path 放在 style 标签内，css 代码高亮会混乱 -->
        <div class="book_clip" style="clip-path: polygon(var(--clip-size) 0, 100% 0, 100% 100%, 0 100%, 0 var(--clip-size));">
            <div class="left-bar">
                <div
                    class="left-bar_clip"
                    style="clip-path: polygon(calc(var(--clip-size) / 1.3) 0, 100% 0, 100% 100%, 0 100%, 0 calc(var(--clip-size) / 1.3));"
                >
                    <ul class="left-bar-list flex flex-col items-center justify-start p-[0.4rem] w-full h-[85%] bg-[#4B4B4B] rounded-[0_0_1.5rem_1.5rem]">
                        {
                            aboutInfo.map((group, gi) =>
                                group.item.map((column, ci) => (
                                    <li
                                        data-role="column-tab"
                                        data-group={gi}
                                        data-column={ci}
                                        class:list={[{ active: gi === 0 && ci === 0, hidden: !(gi === 0 && ci === 0) }]}
                                    >
                                        {column.title}
                                    </li>
                                ))
                            )
                        }
                    </ul>
                </div>
            </div>
            <div class="right-part">
                <div class="book-panel">
                    {
                        aboutInfo.map((group, gi) =>
                            group.item.map((column, ci) => (
                                <div
                                    data-role="column-panel"
                                    data-group={gi}
                                    data-column={ci}
                                    data-group-title={group.title}
                                    class:list={[{ hidden: !(gi === 0 && ci === 0) }]}
                                >
                                    {group.title === '关于我' ? (
                                        <div class="list-container_net-style">
                                            <ul class="card-grid flex flex-wrap content-start m-4 gap-[2.5%] w-full h-full">
                                                {column.item.map((item, ii) => (
                                                    <li data-role="card" class:list={['w-[5rem]', { active: ii === 0 }]}>
                                                        <div class="card-thumb mb-1">
                                                            <img
                                                                src={item.url}
                                                                alt={item.title}
                                                                class="relative block m-0 w-full border-[3px] border-solid border-[#3F3F3F] rounded-[var(--border-card-about)] cursor-pointer z-[1]"
                                                                loading="lazy"
                                                                decoding="async"
                                                            />
                                                        </div>
                                                        <span class="block w-full py-1.5 px-0 text-center text-xs font-bold leading-3 text-white bg-black rounded-full cursor-pointer">
                                                            {item.title}
                                                        </span>
                                                    </li>
                                                ))}
                                            </ul>
                                            <div class="card-detail">
                                                {column.item.map((item, ii) => (
                                                    <div
                                                        data-role="card-detail"
                                                        class:list={[{ hidden: ii !== 0 }]}
                                                        style="z-index: 2; padding: 1rem; width: 100%;"
                                                    >
                                                        <div class="flex flex-row justify-between">
                                                            <h1 class="font-bold text-3xl text-shadow-black">{item.title}</h1>
                                                            <div>
                                                                <img
                                                                    src={item.url}
                                                                    alt={item.title}
                                                                    class="w-[5rem] border-[var(--border-card-about)]"
                                                                    loading="lazy"
                                                                    decoding="async"
                                                                />
                                                                <img
                                                                    src={item.url}
                                                                    alt=""
                                                                    aria-hidden="true"
                                                                    class="absolute top-[2.5rem] right-[3rem] w-2/5 aspect-square z-[-1] grayscale-[1] opacity-[.3]"
                                                                    loading="lazy"
                                                                    decoding="async"
                                                                />
                                                            </div>
                                                        </div>
                                                        <div class="mt-8 whitespace-pre-line indent-[2em]">
                                                            {item.description?.split('\n').map((paragraph) => <p>{paragraph}</p>)}
                                                        </div>
                                                    </div>
                                                ))}
                                            </div>
                                        </div>
                                    ) : (
                                        <ul class="list-container_linear-style">
                                            {column.item.map((item) => (
                                                <li class="relative flex justify-between pl-4 w-full h-10 text-white bg-[linear-gradient(to_bottom,#404040,#303030)] rounded-[3rem] leading-10">
                                                    <span title={item.title} class="w-[80%] overflow-hidden text-ellipsis whitespace-nowrap">
                                                        {item.title}
                                                    </span>
                                                    <button
                                                        type="button"
                                                        data-url={item.url}
                                                        class="absolute right-0 top-0 m-[.1rem] p-[2px] w-[8rem] h-[calc(100%-.2rem)] text-white bg-[linear-gradient(#080808,#080808),linear-gradient(#343434,#343434)] bg-clip-content border-2 border-[#080808] rounded-[2rem] leading-4 font-bold italic cursor-pointer hover:bg-[linear-gradient(#151515,#151515),linear-gradient(#343434,#343434)]"
                                                    >
                                                        前往
                                                    </button>
                                                </li>
                                            ))}
                                        </ul>
                                    )}
                                </div>
                            ))
                        )
                    }
                </div>
            </div>
        </div>
    </div>
    <div class="book_page">
        <div class="absolute w-4/5 h-[99%] right-1 z-10 border-dashed border-[2px] rounded-[2rem] border-[rgba(0,0,0,0.3)]"></div>
    </div>
</div>
