{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@app/*": ["app/*"],
      "@shared/*": ["src/*"]
    },
    "types": ["vite/client", "node"],
    "strict": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true
  },
  "include": [
    "app/**/*.ts",
    "app/**/*.vue",
    "app/**/*.d.ts",
    "src/config/**/*.ts",
    "src/data/**/*.ts",
    "src/types/**/*.ts",
    "vite.config.ts"
  ]
}
